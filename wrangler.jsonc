{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maalem",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // قاعدة البيانات D1 — تُنشأ تلقائياً عند أول نشر باسم maalem-db (بلا database_id)،
  // ويُعاد ربطها بالقاعدة نفسها في كل نشر لاحق.
  "d1_databases": [
    { "binding": "DB", "database_name": "maalem-db", "migrations_dir": "migrations" }
  ],
  // تخزين المرفقات R2 — تُنشأ الحاوية تلقائياً عند أول نشر باسم maalem-files
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "maalem-files" }],
  // جدولان لا ثلاثة: سقفُ خطة Workers المجانية خمسةُ جداول **للحساب كله** لا للعامل
  // الواحد، فثالثُها تردّه واجهة Cloudflare ويسقط النشر كله معه (10072).
  // الساعيُّ يرسل التذكيرات المخصصة في مواعيدها، وفي الرابعة — 07:00 بتوقيت الرياض —
  // يحمل التذكيرات الثابتة بدلاً منها، وتُزاح المخصصةُ تلك الساعةَ وحدَها إلى 04:10.
  // وجدولُ العشر دقائق يصرّف طابور الإشعارات إلى الأجهزة والبريد. ولا يُجمع عملان في
  // استدعاءٍ واحد: لكل استدعاءٍ مجدولٍ ميزانيتُه الخمسون من الطلبات الفرعية. (src/worker.ts)
  "triggers": { "crons": ["0 * * * *", "*/10 * * * *"] },
  // متغيرات اختيارية فقط. لا أسرار مطلوبة: مفاتيح الجلسات والتذكيرات وإشعارات الدفع
  // تُولَّد تلقائياً عند الإعداد الأولي وتُحفظ في قاعدة البيانات.
  "vars": {
    "VAPID_SUBJECT": "mailto:admin@example.com",
    // أصلُ الموقع. يُكتب هنا لا في لوحة Cloudflare: اللوحةُ تُمحى عند كل
    // `wrangler deploy`. وغيابُه يكسر أمرين — روابطُ البريد تصير `undefined`،
    // والأخطرُ أن OpenNext يملأ `process.env` **مرةً واحدة لكل نسخة عاملة**،
    // فإن كان أولُ طلبٍ فيها استدعاءً مجدولاً ثُبّت أصلُها على `maalem.local`
    // طوال عمرها. ويُبدَّل إن رُبط نطاقٌ خاص.
    "APP_URL": "https://maalem.fahad2ao.workers.dev"
  }
}
