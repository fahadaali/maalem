{
  "name": "maalem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-sw.mjs && next dev --turbopack",
    "build": "node scripts/build-sw.mjs && node scripts/sync-schema-sql.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "vapid": "node scripts/vapid.mjs",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "cf:build": "node scripts/build-sw.mjs && node scripts/sync-schema-sql.mjs && opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:migrate:local": "wrangler d1 migrations apply maalem-db --local",
    "d1:migrate": "wrangler d1 migrations apply maalem-db --remote",
    "d1:migration:new": "prisma migrate diff --from-local-d1 --to-schema-datamodel prisma/schema.prisma --script",
    "d1:seed": "node scripts/d1-seed.mjs",
    "sync:schema": "node scripts/sync-schema-sql.mjs",
    "build:sw": "node scripts/build-sw.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "next": "15.5.25",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22"
  }
}
