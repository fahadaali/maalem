generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  username             String    @unique
  name                 String
  phone                String?
  email                String?
  passwordHash         String
  role                 String    @default("PARTICIPANT") // ADMIN | PARTICIPANT | MENTOR
  active               Boolean   @default(true)
  cohortId             String?
  cohort               Cohort?   @relation(fields: [cohortId], references: [id])
  charterAcceptedAt    DateTime?
  charterName          String?
  surveyDoneAt         DateTime?
  portfolioSubmittedAt DateTime?
  mentorId             String?
  mentor               User?     @relation("Mentorship", fields: [mentorId], references: [id])
  mentees              User[]    @relation("Mentorship")
  createdAt            DateTime  @default(now())

  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  attendance        Attendance[]
  readingCards      ReadingCard[]
  weeklyReports     WeeklyReport[]
  quizAttempts      QuizAttempt[]
  submissions       Submission[]
  fieldLogs         FieldLog[]
  leadership        LeadershipActivity[]
  peerEvaluations   PeerEvaluation[]
  project           GraduationProject?
  learningPlan      LearningPlan?
  reflections       Reflection[]
  habits            Habit[]
  tadabbur          TadabburStop[]
  feedbackSessions  FeedbackSession[]
  diagnostics       Diagnostic[]
  certificate       Certificate?
  mentorEvaluations MentorEvaluation[]   @relation("MentorEvalOf")
  evaluationsGiven  MentorEvaluation[]   @relation("MentorEvalBy")
}

/// دفعة من دفعات البرنامج: تفصل بيانات كل دفعة عن غيرها
model Cohort {
  id        String    @id @default(cuid())
  name      String    @unique
  startDate String // YYYY-MM-DD (سبت اللقاء الافتتاحي)
  active    Boolean   @default(false)
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  users       User[]
  weeks       ProgramWeek[]
  assignments Assignment[]
  quizzes     Quiz[]
  budget      BudgetEntry[]
  guests      Guest[]
  minutes     SessionMinutes[]
  reports     ProgramReport[]
  survey      SurveyResponse[]
}

/// أسابيع البرنامج: تُبذر من الخطة وتبقى قابلة للتعديل من لوحة مدير المشروع
model ProgramWeek {
  id           String   @id @default(cuid())
  cohortId     String?
  cohort       Cohort?  @relation(fields: [cohortId], references: [id])
  number       Int
  label        String
  hijri        String
  gregorian    String // YYYY-MM-DD (السبت)
  competency   String
  session      String
  circle       String
  reading      String
  task         String
  meetingPlace String?
  remoteUrl    String?
  note         String?
  updatedAt    DateTime @updatedAt

  @@unique([cohortId, number])
}

/// التقييم التشخيصي: قياس ذاتي للكفاءات الثماني قبل البرنامج وبعده
model Diagnostic {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage     String // PRE | POST
  scores    String // JSON: { "<slug>": 1..5 }
  notes     String?
  createdAt DateTime @default(now())

  @@unique([userId, stage])
}

/// مكتبة المواد: الكتب والقوالب والأدلة
model Material {
  id          String   @id @default(cuid())
  title       String
  kind        String // BOOK | TEMPLATE | GUIDE | LINK
  author      String?
  description String?
  url         String?
  competency  String?
  week        Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

/// محضر لقاء حضوري أو حلقة نقاش
model SessionMinutes {
  id        String   @id @default(cuid())
  cohortId  String?
  cohort    Cohort?  @relation(fields: [cohortId], references: [id])
  week      Int
  type      String // INPERSON | REMOTE | MONTHLY
  date      DateTime
  title     String?
  guestName String?
  present   String? // أسماء الحاضرين كما رصدها المدير
  minutes   String
  decisions String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cohortId, week, type])
}

/// الخبراء وضيوف اللقاءات الشهرية، ومعهم قائمة البدائل
model Guest {
  id       String  @id @default(cuid())
  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id])
  name     String
  topic    String
  week     Int?
  contact  String?
  status   String  @default("CANDIDATE") // CANDIDATE | CONFIRMED | DONE | DECLINED
  backup   Boolean @default(false)
  notes    String?

  createdAt DateTime @default(now())
}

/// بنود الميزانية: المقدّر من الخطة مقابل المصروف الفعلي
model BudgetEntry {
  id       String    @id @default(cuid())
  cohortId String?
  cohort   Cohort?   @relation(fields: [cohortId], references: [id])
  item     String
  basis    String?
  planned  Float     @default(0)
  actual   Float?
  optional Boolean   @default(false)
  note     String?
  order    Int       @default(0)
  spentAt  DateTime?
}

/// استبانة رضا المشاركين — مجهولة: لا تُربط الإجابات بصاحبها
model SurveyResponse {
  id        String   @id @default(cuid())
  cohortId  String?
  cohort    Cohort?  @relation(fields: [cohortId], references: [id])
  answers   String // JSON: { "<key>": 1..5 }
  liked     String?
  improve   String?
  createdAt DateTime @default(now())
}

/// التقرير الشهري للجهة والتقرير الختامي
model ProgramReport {
  id              String   @id @default(cuid())
  cohortId        String?
  cohort          Cohort?  @relation(fields: [cohortId], references: [id])
  kind            String // MONTHLY | FINAL
  period          String // مثال: "الشهر الأول" أو "ختامي"
  summary         String
  highlights      String?
  challenges      String?
  lessons         String?
  recommendations String?
  snapshot        String? // JSON بأرقام المنصة وقت الإعداد
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cohortId, kind, period])
}

/// تقييم المشرف المرافق للمشارك في المعايشة الميدانية
model MentorEvaluation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("MentorEvalOf", fields: [userId], references: [id], onDelete: Cascade)
  mentorId    String
  mentor      User     @relation("MentorEvalBy", fields: [mentorId], references: [id], onDelete: Cascade)
  period      String // منتصف البرنامج | ختامي
  regularity  Int // الانتظام والالتزام بالمواعيد
  engagement  Int // التفاعل والملاحظة والسؤال
  application Int // التطبيق العملي في الميدان
  conduct     Int // أدب التعامل مع المتربين
  growth      Int // التطور خلال المدة
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, period])
}

/// وثيقة الإتمام
model Certificate {
  id       String   @id @default(cuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serial   String   @unique
  level    String
  total    Float
  note     String?
  issuedAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Attendance {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  week   Int
  type   String // INPERSON | REMOTE
  status String // PRESENT | LATE | EXCUSED | ABSENT
  note   String?

  /// بطاقة رصد المشاركة الفاعلة 1..5
  participation Int?
  /// تقييم المشاركة في حلقة النقاش 1..5 (عن بُعد)
  circleScore   Int?

  @@unique([userId, week, type])
}

model ReadingCard {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  book      String
  fromPage  Int
  toPage    Int
  benefit   String
  question  String?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model WeeklyReport {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  week         Int
  reading      String
  benefits     String
  taskProgress String
  fieldNote    String?
  quizResult   String?
  application  String?
  difficulty   String?
  submittedAt  DateTime  @default(now())
  feedback     String?
  reviewedAt   DateTime?

  @@unique([userId, week])
}

model Quiz {
  id        String        @id @default(cuid())
  cohortId  String?
  cohort    Cohort?       @relation(fields: [cohortId], references: [id])
  title     String
  kind      String        @default("FIQH") // FIQH | QURAN | OTHER
  week      Int?
  passMark  Int           @default(70)
  published Boolean       @default(false)
  createdAt DateTime      @default(now())
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id           String @id @default(cuid())
  quizId       String
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order        Int
  text         String
  options      String // JSON array of strings
  correctIndex Int
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  total     Int
  answers   String // JSON array of chosen indexes
  createdAt DateTime @default(now())

  @@unique([quizId, userId])
}

model Assignment {
  id          String       @id @default(cuid())
  cohortId    String?
  cohort      Cohort?      @relation(fields: [cohortId], references: [id])
  week        Int
  title       String
  description String?
  competency  String?
  dueAt       DateTime
  createdAt   DateTime     @default(now())
  submissions Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String
  link         String?
  submittedAt  DateTime   @default(now())
  // rubric (Appendix 2) 1..4 each
  completeness Int?
  referencing  Int?
  application  Int?
  punctuality  Int?
  feedback     String?
  gradedAt     DateTime?

  @@unique([assignmentId, userId])
}

model FieldLog {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  hours      Float
  mentorName String
  note       String
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId, date])
}

model LeadershipActivity {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  date        DateTime
  report      String?
  createdAt   DateTime         @default(now())
  evaluations PeerEvaluation[]
}

model PeerEvaluation {
  id          String             @id @default(cuid())
  activityId  String
  activity    LeadershipActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  evaluatorId String
  evaluator   User               @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  c1          Int
  c2          Int
  c3          Int
  c4          Int
  c5          Int
  comment     String?
  createdAt   DateTime           @default(now())

  @@unique([activityId, evaluatorId])
}

model GraduationProject {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic        String
  problem      String?
  mentorName   String?
  status       String   @default("PROPOSED") // PROPOSED | APPROVED | DRAFT | FINAL | JUDGED
  draftLink    String?
  finalLink    String?
  adminNote    String?
  // judging (30): 5 + 7 + 8 + 5 + 5
  clarity      Int?
  grounding    Int?
  design       Int?
  integration  Int?
  presentation Int?
  judgeNote    String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model LearningPlan {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals        String
  weeklyPlan   String
  memorization String
  updatedAt    DateTime @updatedAt
}

model Reflection {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @default(now())
  text   String
}

model Habit {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())
  logs      HabitLog[]
}

model HabitLog {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    String // YYYY-MM-DD

  @@unique([habitId, date])
}

model TadabburStop {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  week      Int
  topic     String
  notes     String?
  createdAt DateTime @default(now())
}

model FeedbackSession {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @default(now())
  notes  String
}

model ChecklistItem {
  id     String    @id @default(cuid())
  group  String
  order  Int
  label  String
  done   Boolean   @default(false)
  doneAt DateTime?

  @@unique([group, order])
}

model Setting {
  key   String @id
  value String
}

model Attachment {
  id          String   @id @default(cuid())
  userId      String
  kind        String // SUBMISSION | PROJECT | FIELD | REPORT | OTHER
  refId       String?
  key         String   @unique
  name        String
  size        Int
  contentType String
  createdAt   DateTime @default(now())

  @@index([userId, kind, refId])
}
